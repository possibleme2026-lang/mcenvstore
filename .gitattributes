# Normalize line endings: store LF in the repo, check out native on Windows.
* text=auto eol=lf

# Binary assets must never be touched by the eol filter.
*.png binary
*.jpg binary
*.ico binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Generated / vendored files are excluded from language stats.
assets/fonts/* linguist-vendored
thumbnail.png  linguist-documentation
